PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Csak szerveren! Az anonim lemondás után előléptetett csapat értesítéséhez.
SUPABASE_SERVICE_ROLE_KEY=
# Resend (https://resend.com) — ha üres, a visszaigazoló e-mailek kimaradnak.
RESEND_API_KEY=
# Hitelesített domainről, pl. "EquaCards Kvíz <kviz@example.hu>"
EMAIL_FROM=
EMAIL_REPLY_TO=

# Két domain (élesben): nyilvános oldal és app. Üresen minden egy hoston fut.
PUBLIC_SITE_URL=
PUBLIC_APP_URL=

# Claude API — AI kérdésjavaslat és -ellenőrzés a kvízösszerakóban.
# Ha üres, az AI-gombok inaktívak. docs/features/ai-assistant.md
ANTHROPIC_API_KEY=
# Nem kötelező; üresen a legújabb elérhető Opus modell.
ANTHROPIC_MODEL=
